{
  "name": "Weekly Dev Summary — Claude Code + GitHub",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Friday 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{ $json.repo }}/commits",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $json.github_token }}" },
            { "name": "Accept", "value": "application/vnd.github+json" }
          ]
        },
        "queryParameters": {
          "parameters": [
            { "name": "since", "value": "{{ $json.since }}" },
            { "name": "per_page", "value": 100 }
          ]
        },
        "options": {}
      },
      "id": "fetch-commits",
      "name": "Fetch Commits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{ $json.repo }}/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $json.github_token }}" },
            { "name": "Accept", "value": "application/vnd.github+json" }
          ]
        },
        "queryParameters": {
          "parameters": [
            { "name": "state", "value": "closed" },
            { "name": "since", "value": "{{ $json.since }}" },
            { "name": "per_page", "value": 100 }
          ]
        },
        "options": {}
      },
      "id": "fetch-issues",
      "name": "Fetch Closed Issues",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{ $json.repo }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $json.github_token }}" },
            { "name": "Accept", "value": "application/vnd.github+json" }
          ]
        },
        "queryParameters": {
          "parameters": [
            { "name": "state", "value": "closed" },
            { "name": "sort", "value": "updated" },
            { "name": "direction", "value": "desc" },
            { "name": "per_page", "value": 50 }
          ]
        },
        "options": {}
      },
      "id": "fetch-prs",
      "name": "Fetch Merged PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 600]
    },
    {
      "parameters": {
        "jsCode": "// Merge and prepare data for Claude API\nconst commits = $input.all()[0].json;\nconst issues = $input.all()[1].json;\nconst prs = $input.all()[2].json;\nconst config = $('Set Config').item.json;\n\n// Extract the arrays from HTTP responses\nconst commitList = Array.isArray(commits) ? commits : [];\nconst issueList = Array.isArray(issues) ? issues : [];\nconst prList = Array.isArray(prs) ? prs : [];\n\n// Filter to last 7 days\nconst weekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n\nconst recentCommits = commitList.filter(c => new Date(c.commit?.author?.date) > weekAgo);\nconst recentIssues = issueList.filter(i => new Date(i.closed_at) > weekAgo);\nconst mergedPRs = prList.filter(p => p.merged_at && new Date(p.merged_at) > weekAgo);\n\n// Build structured context for Claude\nconst context = {\n  repo: config.repo,\n  week: `${weekAgo.toISOString().slice(0, 10)} to ${new Date().toISOString().slice(0, 10)}`,\n  stats: {\n    commits: recentCommits.length,\n    issuesClosed: recentIssues.length,\n    prsMerged: mergedPRs.length\n  },\n  commits: recentCommits.slice(0, 20).map(c => ({\n    message: c.commit?.message?.split('\\n')[0] || '',\n    author: c.commit?.author?.name || c.author?.login,\n    sha: c.sha?.slice(0, 7),\n    date: c.commit?.author?.date\n  })),\n  issuesClosed: recentIssues.slice(0, 15).map(i => ({\n    title: i.title,\n    number: i.number,\n    closed_by: i.closed_by?.login || i.user?.login,\n    labels: (i.labels || []).map(l => l.name)\n  })),\n  prsMerged: mergedPRs.slice(0, 15).map(p => ({\n    title: p.title,\n    number: p.number,\n    author: p.user?.login,\n    merged_at: p.merged_at\n  }))\n};\n\nreturn {\n  json: {\n    prompt: `You are a technical project manager writing a weekly dev summary.\\n\\n## Repository: ${context.repo}\\n## Period: ${context.week}\\n\\n## By the Numbers\\n- ${context.stats.commits} commits\\n- ${context.stats.issuesClosed} issues closed\\n- ${context.stats.prsMerged} PRs merged\\n\\n## Recent Commits\\n${context.commits.map(c => `- ${c.message} (${c.author}, ${c.sha})`).join('\\n')}\\n\\n## Closed Issues\\n${context.issuesClosed.map(i => `- #${i.number} ${i.title} [${i.labels.join(', ')}]`).join('\\n')}\\n\\n## Merged PRs\\n${context.prsMerged.map(p => `- #${p.number} ${p.title} by ${p.author}`).join('\\n')}\\n\\n---\\nWrite a 3-4 paragraph weekly summary in ${config.language || 'English'}. Include:\\n1. One-line headline capturing the week's theme\\n2. Key accomplishments (2-3 bullets)\\n3. Notable changes or decisions\\n4. One sentence looking ahead\\n\\nTone: professional but friendly. Keep it under 300 words.`,\n    model: 'claude-sonnet-4-20250514',\n    max_tokens: 600,\n    context: context\n  }\n};\n"
      },
      "id": "prepare-prompt",
      "name": "Prepare Claude Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "{{ $json.anthropic_key }}" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "claude-sonnet-4-20250514" },
            { "name": "max_tokens", "value": 600 },
            { "name": "messages[0].role", "value": "user" },
            { "name": "messages[0].content", "value": "={{ $json.prompt }}" }
          ]
        },
        "options": {}
      },
      "id": "call-claude",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [950, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.all()[0].json;\nconst claudeText = response.content?.[0]?.text || 'No summary generated.';\nconst config = $('Set Config').item.json;\nconst context = $input.all()[1]?.json?.context || {};\n\nconst date = new Date().toISOString().slice(0, 10);\n\nreturn {\n  json: {\n    subject: `📊 Weekly Dev Summary — ${context.repo} (${context.week || date})`,\n    body: claudeText,\n    footer: `\\n\\n---\\n_Generated by Claude Code + n8n on ${date}_\\n_${context.stats?.commits || 0} commits · ${context.stats?.issuesClosed || 0} issues · ${context.stats?.prsMerged || 0} PRs_`,\n    repo: config.repo,\n    delivery: config.delivery_method\n  }\n};\n"
      },
      "id": "format-output",
      "name": "Format Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.delivery === 'slack' ? '{{ $json.slack_webhook }}' : '' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "=*{{ $json.subject }}*\n{{ $json.body }}{{ $json.footer }}" }
          ]
        },
        "options": {}
      },
      "id": "send-slack",
      "name": "Send to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.delivery === 'discord' ? '{{ $json.discord_webhook }}' : '' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "content", "value": "=**{{ $json.subject }}**\n{{ $json.body }}{{ $json.footer }}" }
          ]
        },
        "options": {}
      },
      "id": "send-discord",
      "name": "Send to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.delivery === 'email' ? 'https://api.resend.com/emails' : '' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $json.resend_key }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "from", "value": "{{ $json.email_from }}" },
            { "name": "to", "value": "{{ $json.email_to }}" },
            { "name": "subject", "value": "={{ $json.subject }}" },
            { "name": "text", "value": "={{ $json.body }}{{ $json.footer }}" }
          ]
        },
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email (Resend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1450, 600]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "repo", "value": "owner/repo-name" },
            { "name": "github_token", "value": "ghp_xxxx" },
            { "name": "anthropic_key", "value": "sk-ant-xxxx" },
            { "name": "since", "value": "={{ new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString() }}" },
            { "name": "language", "value": "EN" },
            { "name": "delivery_method", "value": "slack" },
            { "name": "slack_webhook", "value": "https://hooks.slack.com/services/xxx" },
            { "name": "discord_webhook", "value": "https://discord.com/api/webhooks/xxx" },
            { "name": "resend_key", "value": "re_xxxx" },
            { "name": "email_from", "value": "bot@example.com" },
            { "name": "email_to", "value": "team@example.com" }
          ]
        },
        "options": {}
      },
      "id": "set-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [250, 550]
    }
  ],
  "connections": {
    "Every Friday 5pm": { "main": [[ { "node": "Set Config", "type": "main", "index": 0 } ]] },
    "Set Config": {
      "main": [[
        { "node": "Fetch Commits", "type": "main", "index": 0 },
        { "node": "Fetch Closed Issues", "type": "main", "index": 0 },
        { "node": "Fetch Merged PRs", "type": "main", "index": 0 }
      ]]
    },
    "Fetch Commits": { "main": [[ { "node": "Prepare Claude Prompt", "type": "main", "index": 0 } ]] },
    "Fetch Closed Issues": { "main": [[ { "node": "Prepare Claude Prompt", "type": "main", "index": 1 } ]] },
    "Fetch Merged PRs": { "main": [[ { "node": "Prepare Claude Prompt", "type": "main", "index": 2 } ]] },
    "Prepare Claude Prompt": { "main": [[ { "node": "Call Claude API", "type": "main", "index": 0 } ]] },
    "Call Claude API": { "main": [[ { "node": "Format Summary", "type": "main", "index": 0 } ]] },
    "Format Summary": {
      "main": [[
        { "node": "Send to Slack", "type": "main", "index": 0 },
        { "node": "Send to Discord", "type": "main", "index": 0 },
        { "node": "Send Email (Resend)", "type": "main", "index": 0 }
      ]]
    }
  },
  "settings": {
    "callerPolicy": "workflowsFromSameOwner",
    "executionOrder": "v1"
  },
  "staticData": null,
  "versionId": "1.0.0",
  "id": "weekly-dev-summary-claude",
  "active": false,
  "createdAt": "2026-05-20T00:00:00.000Z",
  "updatedAt": "2026-05-20T00:00:00.000Z"
}
